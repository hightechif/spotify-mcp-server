# Spotify API Developer Credentials
# Get these from the Spotify Developer Dashboard (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# Spotify OAuth Redirect URI (required for token generation flow)
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Spotify Refresh Token (required for headless server execution)
# Run the authentication flow script to retrieve this token
SPOTIFY_REFRESH_TOKEN=your_spotify_refresh_token_here

# Optional configuration
SPOTIFY_REDIRECT_PORT=8888
